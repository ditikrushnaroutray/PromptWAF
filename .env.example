# WAF_OPENAI_API_KEY is required for forwarding requests to OpenAI.
# This is the real OpenAI API key that PromptWAF will use upstream.
WAF_OPENAI_API_KEY=sk-your-openai-api-key-here

# WAF_MODE controls enforcement behavior:
#   BLOCK   — (Default) Fail-closed. Malicious requests return 403.
#   MONITOR — Shadow mode. Logs attacks but forwards all traffic.
WAF_MODE=BLOCK

# PROTECTED_SYSTEM_PROMPT is used for output leakage detection.
# Paste your application's system prompt here so PromptWAF can detect
# if the LLM is leaking it in responses.
PROTECTED_SYSTEM_PROMPT="You are a helpful assistant..."

# Rate limiting (per API key or IP). Uses Redis for distributed counting.
WAF_RATE_LIMIT=50/minute

# WAF engine timeout (seconds). Requests exceeding this are blocked (fail-closed).
WAF_TIMEOUT_SECONDS=5.0

# Maximum allowed prompt length (characters). Longer prompts are auto-blocked.
MAX_PROMPT_LENGTH=50000

# Semantic similarity threshold (0.0–1.0). Higher = stricter.
SEMANTIC_SIMILARITY_THRESHOLD=0.8

# Output leakage similarity threshold (0.0–1.0).
LEAKAGE_SIMILARITY_THRESHOLD=0.7

# Optional: Enable the GPT-4o-mini LLM judge (Layer 3). Adds latency and cost.
WAF_ENABLE_LLM_JUDGE=false

# Optional: Override exposed ports (defaults shown)
# WAF_PORT=8000
# REDIS_PORT=6379
# PROMETHEUS_PORT=9090
