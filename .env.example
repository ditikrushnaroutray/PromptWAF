# PromptWAF Environment Configuration

# ---------------------------------------------------------------------------
# Required Settings
# ---------------------------------------------------------------------------
# Your real OpenAI API key for upstream forwarding. This is mandatory.
WAF_OPENAI_API_KEY=sk-your-openai-api-key-here

# ---------------------------------------------------------------------------
# Security & Enforcement Modes
# ---------------------------------------------------------------------------
# WAF Mode: BLOCK (fail-closed enforcement) or MONITOR (shadow mode / log-only)
WAF_MODE=BLOCK

# If true, WAF engine errors or timeouts result in blocked traffic (fail-closed)
WAF_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Detection & Thresholds
# ---------------------------------------------------------------------------
# The core prompt/instructions you want to protect from leakage
PROTECTED_SYSTEM_PROMPT="You are a helpful assistant..."

# Maximum prompt character count before auto-blocking
MAX_PROMPT_LENGTH=50000

# Enable input de-obfuscation (NFKC, zero-width, Base64/Hex decoding)
ENABLE_NORMALIZATION=true

# Maximum recursive decoding depth for nested payloads (e.g. Base64 inside Hex)
MAX_NORMALIZATION_DEPTH=3

# Cosine similarity threshold for semantic jailbreak detection (0.0 to 1.0)
SEMANTIC_SIMILARITY_THRESHOLD=0.8

# Optional: Path to a custom JSON corpus of jailbreak intents
# SEMANTIC_CORPUS_PATH=/app/data/jailbreaks.json

# Similarity threshold for output leakage detection (0.0 to 1.0)
LEAKAGE_SIMILARITY_THRESHOLD=0.7

# Enable the optional GPT-4o-mini LLM judge (Adds latency and cost)
WAF_ENABLE_LLM_JUDGE=false

# ---------------------------------------------------------------------------
# Performance & Architecture
# ---------------------------------------------------------------------------
# Max seconds for WAF analysis before triggering a fail-closed block
WAF_TIMEOUT_SECONDS=5.0

# Rate limit per API key or IP address (e.g., 50/minute, 10/second)
WAF_RATE_LIMIT=50/minute

# Redis connection string for distributed rate limiting (default memory://)
REDIS_URL=memory://

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Async Database connection string (e.g., postgresql+asyncpg://... or sqlite+aiosqlite://...)
DATABASE_URL=sqlite+aiosqlite:////tmp/waf.db

# ---------------------------------------------------------------------------
# Internal Application Settings
# ---------------------------------------------------------------------------
# Secret key for signing internal tokens. Set to a 32-byte random string in production.
SECRET_KEY=your-super-secret-key-change-me
